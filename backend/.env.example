# Server Configuration
PORT=3000

# Database Connection (Supabase PostgreSQL)
# Get this from Supabase Dashboard -> Connect button -> URI (Port 5432 or 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Optional: Direct connection for migrations (if needed)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase API Keys (if using @supabase/supabase-js)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-here"

# ---------------------------------------------------------------------------
# Development seed passwords (Batch 4)
#
# Used ONLY by `npm run db:seed` to create the deterministic development
# fixtures in scripts/seed.ts. Set real values in your local .env only.
#
# NEVER set these in production/Render/Vercel. Before deploying, remove them
# from the production environment and confirm `db:seed` is not part of any
# startup/build/deploy command. See the deployment safety checklist at the top
# of backend/scripts/seed.ts.
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_PASSWORD=""
SEED_STAFF_PASSWORD=""

# Required only to run `npm run db:seed:remove`. Must equal this exact value.
# Deliberately has no default: teardown refuses to run without it.
SEED_REMOVE_CONFIRM=""
