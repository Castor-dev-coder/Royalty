{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/modules/appointments/*.test.ts src/modules/accounts/*.test.ts src/modules/auth/*.test.ts src/modules/customers/*.test.ts src/modules/services/*.test.ts src/modules/staff/*.test.ts src/modules/schedules/*.test.ts src/modules/reviews/*.test.ts src/modules/images/*.test.ts src/modules/matching/*.test.ts src/modules/attendance/*.test.ts src/routes/*.test.ts src/utils/*.test.ts",
    "test:integration": "tsx --test --test-force-exit --test-concurrency=4 src/test/integration/*.test.ts",
    "start": "node dist/server.js",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:migrate": "prisma db migrate",
    "db:seed": "tsx scripts/seed.ts seed",
    "db:system-admin": "tsx scripts/create-system-admin.ts",
    "db:seed:remove": "tsx scripts/seed.ts remove"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.12",
    "@prisma/orm-target-postgres": "^8.0.0-rc.12",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.1",
    "prisma": "^8.0.0-rc.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
