      {
        "description": "create table \"review_ratings\"",
        "sql": "CREATE TABLE \"public\".\"review_ratings\" (\n  \"category\" \"review_rating_category\" NOT NULL,\n  \"id\" uuid DEFAULT (gen_random_uuid()) NOT NULL,\n  \"rating\" int2 NOT NULL,\n  \"review_id\" uuid NOT NULL,\n  CONSTRAINT \"review_ratings_pkey\" PRIMARY KEY (\"id\"),\n  CONSTRAINT \"valid_review_rating\" CHECK (((rating >= 1) AND (rating <= 5)))\n)",
        "params": []
      }
    ],
    "postcheck": [
